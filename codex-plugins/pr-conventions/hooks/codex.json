{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/no-ai-attribution-footer.sh\"",
            "timeout": 10,
            "statusMessage": "no-ai-attribution-footer"
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/review-guard.sh\"",
            "timeout": 30,
            "statusMessage": "review-guard"
          }
        ]
      }
    ]
  }
}
