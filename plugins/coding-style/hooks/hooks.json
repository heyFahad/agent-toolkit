{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/eslint-autofix-gate.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
