{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create:*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-staging-conflict-check.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
