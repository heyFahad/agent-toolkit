#!/bin/bash
# Usage: verify --related [FILES...] | --full | --status [--tree SHA] | --list [--related] [FILES...]
#
# Runs a repo's checks and records that they passed, so the verify-gate hook
# lets the tree be committed or pushed. See lib.sh for where the checks come
# from, and the verify skill for when to run each level.
#
#   --related [FILES...]  run the quick checks (lint, and tests related to
#                         FILES, by default the files changed against HEAD)
#   --full                run every check
#   --status [--tree SHA] print the record for a tree (default: the working
#                         tree); exit 1 when there is none
#   --list [--related] [FILES...]  print the checks as JSON [{name, run}]
#
# A run stops at the first failing check. It fails too when a check changes
# tracked files (a format script that writes, a generated file that was out
# of date): review those changes, commit them and run again. Either way it
# writes a record under the hash of the working tree after the run, and under
# its tracked-files-only hash, which the verify-gate hook reads. Untracked
# build output doesn't fail a run.
#
# Exit codes: 0 success (or the gate is off: no checks for this repo); 1 a
# check failed; 2 bad usage or not a git repo; 3 a missing prerequisite (the
# Node version .nvmrc names).
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$HERE/lib.sh"

MODE="" LEVEL=full TREE=""
FILES=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --list) MODE=list ;;
    --status) MODE=status ;;
    --tree)
      [ "$#" -ge 2 ] || vf_die 2 "--tree needs a SHA"
      TREE=$2
      shift
      ;;
    --related)
      LEVEL=related
      [ -n "$MODE" ] || MODE=run
      ;;
    --full)
      LEVEL=full
      MODE=run
      ;;
    -*) vf_die 2 "unknown option $1" ;;
    *) FILES+=("$1") ;;
  esac
  shift
done
[ -n "$MODE" ] || vf_die 2 "usage: verify --related [FILES...] | --full | --status [--tree SHA] | --list [--related] [FILES...]"

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || vf_die 2 "not in a git repository"

if [ "$MODE" = list ]; then
  vf_checks "$ROOT" "$LEVEL" ${FILES[@]+"${FILES[@]}"}
  exit 0
fi

if [ "$MODE" = status ]; then
  [ -n "$TREE" ] || TREE=$(vf_tree "$ROOT") || vf_die 2 "could not hash the working tree"
  f=$(vf_record_file "$TREE")
  [ -f "$f" ] || exit 1
  cat "$f"
  exit 0
fi

# run
if [ "$LEVEL" = related ] && [ "${#FILES[@]}" -eq 0 ]; then
  while IFS= read -r f; do FILES+=("$f"); done < <(vf_changed_files "$ROOT")
fi
CHECKS=$(vf_checks "$ROOT" "$LEVEL" ${FILES[@]+"${FILES[@]}"})
if [ "$(printf '%s' "$CHECKS" | jq length)" -eq 0 ]; then
  echo "verify: no checks for $(vf_repo_key "$ROOT") (gate off): CI runs none and there's no override"
  exit 0
fi
NODE_BIN=$(vf_node_path "$ROOT") || exit $?
STATE=$(vf_state_dir)
mkdir -p "$STATE/logs"
LOG=$(mktemp "$STATE/logs/run.XXXXXX")
BEFORE=$(vf_tracked_tree "$ROOT") || vf_die 2 "could not hash the working tree"

RESULTS="[]" PASSED=true
n=$(printf '%s' "$CHECKS" | jq length)
i=0
while [ "$i" -lt "$n" ]; do
  name=$(printf '%s' "$CHECKS" | jq -r ".[$i].name")
  run=$(printf '%s' "$CHECKS" | jq -r ".[$i].run")
  out=$(mktemp "${TMPDIR:-/tmp}/verify-out.XXXXXX")
  rc=0
  (
    cd "$ROOT"
    [ -z "$NODE_BIN" ] || PATH="$NODE_BIN:$PATH"
    bash -c "$run"
  ) >"$out" 2>&1 </dev/null || rc=$?
  { echo "### $name: $run (exit $rc)"; cat "$out"; } >>"$LOG"
  RESULTS=$(printf '%s' "$RESULTS" | jq -c --arg n "$name" --arg r "$run" --argjson e "$rc" '. + [{name: $n, run: $r, exit: $e}]')
  if [ "$rc" -eq 0 ]; then
    echo "PASS $name"
  else
    echo "FAIL $name (exit $rc)"
    tail -n 30 "$out"
    PASSED=false
  fi
  rm -f "$out"
  [ "$PASSED" = true ] || break
  i=$((i + 1))
done

AFTER=$(vf_tracked_tree "$ROOT") || vf_die 2 "could not hash the working tree"
if [ "$AFTER" != "$BEFORE" ]; then
  echo "FAIL the checks changed tracked files; review the changes, commit them and run verify again:"
  git -C "$ROOT" diff --name-only "$BEFORE" "$AFTER" | sed 's/^/  /'
  PASSED=false
fi

TREE=$(vf_tree "$ROOT") || vf_die 2 "could not hash the working tree"
FINAL_LOG="$STATE/logs/$TREE.log"
mv "$LOG" "$FINAL_LOG"
RECORD=$(jq -n --arg tree "$TREE" --arg tracked "$AFTER" --arg level "$LEVEL" --arg repo "$(vf_repo_key "$ROOT")"   --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson passed "$PASSED" --argjson commands "$RESULTS" --arg log "$FINAL_LOG"   '{tree: $tree, trackedTree: $tracked, level: $level, repo: $repo, at: $at, passed: $passed, commands: $commands, log: $log}')
for t in "$TREE" "$AFTER"; do
  tmp=$(mktemp "$STATE/.record.XXXXXX")
  printf '%s
' "$RECORD" >"$tmp"
  mv "$tmp" "$(vf_record_file "$t")"
done
[ "$PASSED" = true ]
