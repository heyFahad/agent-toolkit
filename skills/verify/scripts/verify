#!/bin/bash
# Usage: verify --related [FILES...] | --branch | --full | --status [--tree SHA] | --list [--related|--branch] [FILES...]
#
# Runs a repo's checks and records that they passed, so the verify-gate hook
# lets the tree be committed or pushed. See lib.sh for where the checks come
# from, and the verify skill for when to run each level.
#
#   --related [FILES...]  run the quick checks (format, lint and typecheck,
#                         and tests related to FILES, by default the files
#                         changed against HEAD)
#   --branch              the quick checks on every file the branch changes
#                         since it split from the default branch (what the
#                         push that creates the branch on the remote needs)
#   --full                run every check
#   --status [--tree SHA] print the record for a tree (default: the working
#                         tree); exit 1 when there is none
#   --list [--related|--branch] [FILES...]  print the checks as JSON
#                         [{name, run}]
#
# A run stops at the first failing check. It fails too when a check changes
# tracked files (a format script that writes, a generated file that was out
# of date): review those changes, commit them and run again. Either way it
# writes a record under the hash of the working tree after the run, and under
# its tracked-files-only hash, which the verify-gate hook reads. Untracked
# build output doesn't fail a run.
#
# Only one run checks at a time on this machine, across every repo and
# session: another one prints that it's queued, and waits for it.
#
# Exit codes: 0 success (or the gate is off: no checks for this repo); 1 a
# check failed; 2 bad usage or not a git repo; 3 a missing prerequisite (the
# Node version .nvmrc names).
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$HERE/lib.sh"

MODE="" LEVEL=full TREE=""
FILES=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --list) MODE=list ;;
    --status) MODE=status ;;
    --tree)
      [ "$#" -ge 2 ] || vf_die 2 "--tree needs a SHA"
      TREE=$2
      shift
      ;;
    --related)
      LEVEL=related
      [ -n "$MODE" ] || MODE=run
      ;;
    --branch)
      LEVEL=branch
      [ -n "$MODE" ] || MODE=run
      ;;
    --full)
      LEVEL=full
      [ -n "$MODE" ] || MODE=run
      ;;
    -*) vf_die 2 "unknown option $1" ;;
    *) FILES+=("$1") ;;
  esac
  shift
done
[ -n "$MODE" ] || vf_die 2 "usage: verify --related [FILES...] | --branch | --full | --status [--tree SHA] | --list [--related|--branch] [FILES...]"

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || vf_die 2 "not in a git repository"

# Named files check only those, so the run can't vouch for the whole tree:
# useful while working, but it writes no record.
EXPLICIT=false
[ "${#FILES[@]}" -eq 0 ] || EXPLICIT=true
# More changed files than this and the commands holding them all can outgrow
# what one argument may be, so the run checks everything instead.
MAX_FILES=500

say() { [ "$MODE" = list ] || echo "$@"; }

# collect_files: fill FILES with the changed files the level checks: the
# working tree against HEAD for related, against where the branch left the
# default branch for branch. May move LEVEL to full.
collect_files() {
  local f base
  [ "$EXPLICIT" = false ] || return 0
  case "$LEVEL" in
    related)
      while IFS= read -r f; do FILES+=("$f"); done < <(vf_changed_files "$ROOT")
      ;;
    branch)
      if base=$(vf_branch_base "$ROOT"); then
        while IFS= read -r f; do FILES+=("$f"); done < <(vf_changed_files "$ROOT" "$base")
        say "verify: --branch checks the ${#FILES[@]} files this branch changes since ${base:0:7}"
      else
        say "verify: no origin/HEAD, origin/main or origin/master to find where this branch started, so --branch runs every check"
        LEVEL=full
      fi
      ;;
  esac
  if [ "$LEVEL" != full ] && [ "${#FILES[@]}" -gt "$MAX_FILES" ]; then
    say "verify: ${#FILES[@]} changed files is more than $MAX_FILES, so this runs every check (--full)"
    LEVEL=full FILES=()
  fi
  return 0
}

if [ "$MODE" = list ]; then
  # --list --related with no files lists the checks that need none.
  [ "$LEVEL" != branch ] || collect_files
  vf_checks "$ROOT" "$LEVEL" ${FILES[@]+"${FILES[@]}"}
  exit 0
fi

if [ "$MODE" = status ]; then
  [ -n "$TREE" ] || TREE=$(vf_tree "$ROOT") || vf_die 2 "could not hash the working tree"
  f=$(vf_record_file "$TREE")
  [ -f "$f" ] || exit 1
  cat "$f"
  exit 0
fi

# run
# The gate is off only when there are no full checks. A related level with
# nothing quick to run (CI runs tests, but no jest or vitest to pick the
# related ones) still records a pass.
if [ "$(vf_checks "$ROOT" full | jq length)" -eq 0 ]; then
  if [ -z "$(vf_override "$ROOT")" ] && [ -n "$(vf_pr_workflows "$ROOT")" ]; then
    echo "verify: no checks for $(vf_repo_key "$ROOT") (gate off): its pull_request workflows run nothing verify can read (no package.json scripts outside advisory continue-on-error steps; tools called through pnpm exec or npx aren't read). Ask the user to set this repo's checks in $(vf_config_file) (see the verify skill)."
  else
    echo "verify: no checks for $(vf_repo_key "$ROOT") (gate off): CI runs none and there's no override"
  fi
  exit 0
fi
NODE_BIN=$(vf_node_path "$ROOT") || exit $?
STATE=$(vf_state_dir)
mkdir -p "$STATE/logs"
# One run at a time on this machine (see vf_lock_acquire). Taken before the
# changed files are listed and the tree is hashed: both may change while
# this waits.
trap 'vf_lock_release' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
vf_lock_acquire "$(vf_repo_key "$ROOT")"
collect_files
CHECKS=$(vf_checks "$ROOT" "$LEVEL" ${FILES[@]+"${FILES[@]}"})
LOG=$(mktemp "$STATE/logs/run.XXXXXX")
BEFORE=$(vf_tracked_tree "$ROOT") || vf_die 2 "could not hash the working tree"

RESULTS="[]" PASSED=true
n=$(printf '%s' "$CHECKS" | jq length)
i=0
while [ "$i" -lt "$n" ]; do
  name=$(printf '%s' "$CHECKS" | jq -r ".[$i].name")
  run=$(printf '%s' "$CHECKS" | jq -r ".[$i].run")
  out=$(mktemp "${TMPDIR:-/tmp}/verify-out.XXXXXX")
  rc=0
  (
    cd "$ROOT"
    [ -z "$NODE_BIN" ] || PATH="$NODE_BIN:$PATH"
    bash -c "$run"
  ) >"$out" 2>&1 </dev/null || rc=$?
  { echo "### $name: $run (exit $rc)"; cat "$out"; } >>"$LOG"
  RESULTS=$(printf '%s' "$RESULTS" | jq -c --arg n "$name" --arg r "$run" --argjson e "$rc" '. + [{name: $n, run: $r, exit: $e}]')
  if [ "$rc" -eq 0 ]; then
    echo "PASS $name"
  else
    echo "FAIL $name (exit $rc)"
    tail -n 30 "$out"
    PASSED=false
  fi
  rm -f "$out"
  [ "$PASSED" = true ] || break
  i=$((i + 1))
done

AFTER=$(vf_tracked_tree "$ROOT") || vf_die 2 "could not hash the working tree"
if [ "$AFTER" != "$BEFORE" ]; then
  echo "FAIL the checks changed tracked files; review the changes, commit them and run verify again:"
  git -C "$ROOT" diff --name-only "$BEFORE" "$AFTER" | sed 's/^/  /'
  PASSED=false
fi

# Untracked files took part in the run. A record also matches the tracked
# files alone, so a commit that leaves one of these out could still be
# pushed: name them.
UNTRACKED=$(cd "$ROOT" && git ls-files --others --exclude-standard)
if [ -n "$UNTRACKED" ]; then
  echo "Untracked files were part of this run; commit the ones the change needs, or the pushed code won't have them:"
  printf '%s\n' "$UNTRACKED" | sed 's/^/  /'
fi

# Prune logs and records nobody has touched for two weeks.
find "$STATE" -type f -mtime +14 -delete 2>/dev/null || true

if [ "$EXPLICIT" = true ]; then
  rm -f "$LOG"
  echo "verify: ran on the named files only, so no record was written; the gate needs a run over every change (verify --$LEVEL with no files)"
  [ "$PASSED" = true ]
  exit
fi

TREE=$(vf_tree "$ROOT") || vf_die 2 "could not hash the working tree"
FINAL_LOG="$STATE/logs/$TREE.log"
mv "$LOG" "$FINAL_LOG"
RECORD=$(jq -n --arg tree "$TREE" --arg tracked "$AFTER" --arg level "$LEVEL" --arg repo "$(vf_repo_key "$ROOT")" \
  --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson passed "$PASSED" --argjson commands "$RESULTS" \
  --arg log "$FINAL_LOG" \
  --argjson untracked "$(printf '%s' "$UNTRACKED" | jq -R -s -c 'split("\n") | map(select(. != ""))')" \
  '{tree: $tree, trackedTree: $tracked, level: $level, repo: $repo, at: $at, passed: $passed, commands: $commands, untracked: $untracked, log: $log}')
for t in "$TREE" "$AFTER"; do
  # A passing run never replaces a passing one at a higher level.
  if [ "$PASSED" = true ] && [ "$LEVEL" != full ] && vf_record_ok "$t" "$([ "$LEVEL" = related ] && echo branch || echo full)"; then
    continue
  fi
  tmp=$(mktemp "$STATE/.record.XXXXXX")
  printf '%s
' "$RECORD" >"$tmp"
  mv "$tmp" "$(vf_record_file "$t")"
done
[ "$PASSED" = true ]
